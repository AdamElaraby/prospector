# Copy to .env and fill in. .env is gitignored.

# --- Lead discovery ---
# Google Places API (New). Optional: without it the free gosom scraper (or the
# built-in Playwright one) is used automatically.
# Enable "Places API (New)" in a Google Cloud project, then create an API key.
GOOGLE_PLACES_API_KEY=

# Apify. Optional, and never chosen automatically — every Apify run bills your
# account, so it has to be asked for with `search.source: apify` or --source apify.
# https://console.apify.com -> Settings -> API & Integrations -> Personal API token
APIFY_API_TOKEN=

# --- Message drafting ---
# Provider is chosen in config.local.yaml (llm.provider: openai | anthropic).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email sending ---
# https://resend.com -> API Keys. Verify your sending domain first (SPF/DKIM/DMARC).
RESEND_API_KEY=
